# Copy to secrets.toml for local use, or paste into Community Cloud secrets.
admin_password = "REPLACE-WITH-A-LONG-UNIQUE-PASSWORD"

# Optional persistent storage; use a separate private DATA repository.
# Upload data/league.json as league.json there before enabling this section.
# [github]
# repository = "YOUR-ACCOUNT/YOUR-PRIVATE-DATA-REPO"
# branch = "main"
# path = "league.json"
# token = "YOUR-FINE-GRAINED-TOKEN"
# Token needs Contents read/write for the data repo only.

# Supabase server-side configuration. Keep real credentials out of Git.
# SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
# SUPABASE_KEY = "YOUR-SERVER-SERVICE-ROLE-SECRET"
# Enable ONLY after sql/001_relational.sql and migrate_relational.py --apply succeed.
# DISCGOLF_STORAGE_MODEL = "relational"
